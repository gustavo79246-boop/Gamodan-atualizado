PORT=3000
FRONTEND_URL=http://localhost:4200
MONGODB_URI=mongodb://127.0.0.1:27017/gamodan
SESSION_SECRET=coloque-uma-chave-aleatoria-grande-aqui
ADMIN_EMAILS=seu-email@exemplo.com
# Steam IDs autorizados como administradores (separe vários por vírgula)
ADMIN_STEAM_IDS=76561199675600582
# Opcional: integração com OpenID da Steam
STEAM_API_KEY=
STEAM_RETURN_URL=http://localhost:3000/auth/steam/return
STEAM_REALM=http://localhost:3000/
NODE_ENV=development

# --- Novidades ---
# Vários endereços do front separados por vírgula (o primeiro é usado nos redirecionamentos)
# FRONTEND_URL=http://localhost:4200,https://meusite.com
# Endereço público da API (usado nas URLs das fotos de perfil). Se vazio, usa o host da requisição.
# PUBLIC_API_URL=https://api.meusite.com
# Só se front e API ficarem em domínios diferentes em produção (exige HTTPS): none
# COOKIE_SAMESITE=lax
